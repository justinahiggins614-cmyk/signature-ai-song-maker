{
  "$id": "https://justinahiggins614-cmyk.github.io/signature-ai-song-maker/schemas/music-manifest.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Signature Music Studio — music-manifest.json",
  "description": "Shape of music-manifest.json at the repo root, written by build_music_manifest() in code/build_site_files.py. It is the single source of truth for every visible count on the site (songs, library, equipment, beats, index hashes, timestamps). Regenerated by the drip/build after every run. NOTE: no 'license' field exists anywhere in the manifest or in the record-page JSON-LD; do not add one.",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "id_range": {
      "type": "object",
      "description": "First/last/count of issued IDs for one kind, computed from the sorted index rows.",
      "properties": {
        "first": {
          "type": "string"
        },
        "last": {
          "type": "string"
        },
        "count": {
          "type": "integer"
        }
      },
      "required": [
        "first",
        "last",
        "count"
      ],
      "additionalProperties": false
    }
  },
  "properties": {
    "schema": {
      "const": "JAH-MUSIC-MANIFEST/1.0"
    },
    "site": {
      "const": "Signature Music Studio"
    },
    "site_number": {
      "const": 23
    },
    "network": {
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "UTC ISO-8601 timestamp of the build."
    },
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "songs",
        "library_sounds",
        "equipment",
        "beats",
        "total",
        "goals",
        "id_ranges"
      ],
      "properties": {
        "songs": {
          "type": "integer"
        },
        "library_sounds": {
          "type": "integer"
        },
        "equipment": {
          "type": "integer"
        },
        "beats": {
          "type": "integer"
        },
        "total": {
          "type": "integer",
          "description": "Total index rows (all kinds)."
        },
        "goals": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "songs",
            "library_sounds"
          ],
          "properties": {
            "songs": {
              "const": 1000000
            },
            "library_sounds": {
              "const": 1000000
            }
          }
        },
        "id_ranges": {
          "type": "object",
          "description": "Computed from the index rows: first/last/count per kind. Keys are the index kind column values (song, sound, gear, beat).",
          "properties": {
            "song": {
              "$ref": "#/definitions/id_range"
            },
            "sound": {
              "$ref": "#/definitions/id_range"
            },
            "gear": {
              "$ref": "#/definitions/id_range"
            },
            "beat": {
              "$ref": "#/definitions/id_range"
            }
          },
          "required": [
            "song",
            "sound",
            "gear",
            "beat"
          ]
        }
      }
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "seed_algorithm",
        "determinism",
        "sound_library_version"
      ],
      "properties": {
        "name": {
          "const": "Signature Music Engine"
        },
        "version": {
          "type": "string",
          "description": "Current engine version. Records' specs are stable across engine upgrades."
        },
        "seed_algorithm": {
          "type": "string",
          "description": "Documented as 'FNV-1a 32-bit (hashSeed)'. ACTUAL implementation in assets/synth.js is xmur3 (MurmurHash3-derived) feeding mulberry32. See DETERMINISM.md."
        },
        "determinism": {
          "type": "string",
          "description": "The manifest's determinism claim. See DETERMINISM.md for the precise guarantee (record spec fully deterministic; render noise layer is not byte-exact)."
        },
        "sound_library_version": {
          "type": "string",
          "description": "Current: SIGSOUND-V1."
        }
      }
    },
    "voices": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "description": "The 4 created voices, mirroring SigSynth.CREATED_VOICES.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "version",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^JAH-VOICE-\\d{6}$"
          },
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string",
            "enum": [
              "v1"
            ]
          },
          "kind": {
            "type": "string",
            "pattern": "^synthesized ",
            "description": "Always 'synthesized <range>' — e.g. 'synthesized soprano'."
          }
        }
      }
    },
    "voices_note": {
      "type": "string",
      "description": "All voices are synthesized. There are no human singers on this site — no exceptions."
    },
    "index": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "records",
        "sha256",
        "row_format",
        "chunk_pointers_verified"
      ],
      "properties": {
        "file": {
          "const": "data/index/index.json.gz"
        },
        "records": {
          "type": "integer",
          "description": "Row count of the index."
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "SHA-256 hex of the index.json.gz file bytes."
        },
        "row_format": {
          "const": [
            "id",
            "title",
            "kind",
            "chunk"
          ]
        },
        "chunk_pointers_verified": {
          "type": "boolean",
          "description": "True when every index row's chunk pointer was verified to resolve to the record."
        }
      }
    },
    "id_schemes": {
      "type": "object",
      "additionalProperties": false,
      "description": "All ten ID schemes. Five are live with issued records; five are reserved with no records issued yet.",
      "properties": {
        "song": {
          "type": "string"
        },
        "beat": {
          "type": "string"
        },
        "sound": {
          "type": "string"
        },
        "equipment": {
          "type": "string"
        },
        "voice": {
          "type": "string"
        },
        "project": {
          "type": "string"
        },
        "cd": {
          "type": "string"
        },
        "mix": {
          "type": "string"
        },
        "cleanup": {
          "type": "string"
        },
        "patch": {
          "type": "string"
        }
      },
      "required": [
        "song",
        "beat",
        "sound",
        "equipment",
        "voice",
        "project",
        "cd",
        "mix",
        "cleanup",
        "patch"
      ]
    },
    "deep_links": {
      "type": "object",
      "additionalProperties": false,
      "description": "Canonical per-record URL patterns (relative to the site base).",
      "properties": {
        "song": {
          "type": "string"
        },
        "sound": {
          "type": "string"
        },
        "gear": {
          "type": "string"
        },
        "beat": {
          "type": "string"
        }
      },
      "required": [
        "song",
        "sound",
        "gear",
        "beat"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generated_by",
        "composition_stable",
        "audio_synthesis"
      ],
      "properties": {
        "generated_by": {
          "type": "string"
        },
        "composition_stable": {
          "type": "string",
          "description": "The song spec (notes/chords/lyrics/structure) is stable even if the render engine improves."
        },
        "audio_synthesis": {
          "type": "string"
        }
      }
    }
  },
  "required": [
    "schema",
    "site",
    "site_number",
    "network",
    "generated_at",
    "archive",
    "engine",
    "voices",
    "voices_note",
    "index",
    "id_schemes",
    "deep_links",
    "provenance"
  ]
}
